# ==============================================================================
# Chalo Backend — Docker Environment Configuration Template (.env.docker.example)
#
# INSTRUCTIONS FOR REVIEWER:
# 1. Copy this file to create your local .env:
#      cp chalo-backend/.env.docker.example chalo-backend/.env
# 2. Fill in your valid Supabase PostgreSQL and Upstash Redis REST credentials.
# 3. DO NOT commit actual secrets or credentials to Git.
# ==============================================================================

# ==============================================================================
# 1. SERVER & NETWORK CONFIGURATION
# ==============================================================================
# Port on which Express and Socket.IO listen inside the container (default: 4000)
PORT=4000

# Set NODE_ENV to "development" for local HTTP testing.
# IMPORTANT: Setting NODE_ENV=production causes modern browsers to reject
# authentication cookies over plain HTTP (http://localhost:3000) due to SameSite=None; Secure.
NODE_ENV=development

# Allowed client origin for CORS headers and Socket.IO handshake
CLIENT_URL=http://localhost:3000


# ==============================================================================
# 2. SUPABASE POSTGRESQL DATABASE
# ==============================================================================
# Supabase Transaction-Mode Connection Pooler (used by Prisma client at runtime):
# IPv4-compatible connection string with pgbouncer=true on port 6543
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Session mode, port 5432, used for Prisma migrations):
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"


# ==============================================================================
# 3. UPSTASH REDIS (HTTP REST API)
# ==============================================================================
# NOTE: Chalo uses @upstash/redis REST client (HTTP requests over HTTPS).
# Standard Redis TCP (redis://localhost:6379) will NOT work without an HTTP proxy.
# Obtain your REST URL and Token from your Upstash Console:
UPSTASH_REDIS_REST_URL="https://[YOUR_INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR_UPSTASH_REST_TOKEN]"


# ==============================================================================
# 4. AUTHENTICATION & JWT SECRETS
# ==============================================================================
# Minimum 32 characters recommended for HMAC-SHA256 signature security
JWT_ACCESS_TOKEN="your_jwt_access_secret_min_32_characters_long"
JWT_REFRESH_TOKEN="your_jwt_refresh_secret_min_32_characters_long"

# Token lifespans (e.g., "15m", "7d")
JWT_ACCESS_TOKEN_TIME="15m"
JWT_REFRESH_TOKEN_TIME="7d"


# ==============================================================================
# 5. STRIPE PAYMENT INTEGRATION (TEST MODE)
# ==============================================================================
# Core application startup succeeds without valid Stripe keys (warning is logged),
# but upfront ride payment and escrow require valid test keys.
STRIPE_SECRET_KEY="sk_test_[YOUR_STRIPE_TEST_SECRET_KEY]"
STRIPE_PUBLISHABLE_KEY="pk_test_[YOUR_STRIPE_TEST_PUBLISHABLE_KEY]"
